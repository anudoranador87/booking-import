# =========================================
# BOOKING IMPORT - CONFIGURACIÓN DEL ENTORNO
# =========================================
# Renombra este archivo a ".env" y completa tus datos.

# 1. CONFIGURACIÓN DEL SERVIDOR
PORT=3000

# 2. CREDENCIALES IMAP (Para leer correos automáticamente)
# Por ejemplo, si usas Gmail:
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
# IMAP_USER=tu_correo@gmail.com
# IMAP_PASSWORD=tu_contraseña_de_aplicacion
IMAP_HOST=imap.tu-servidor.com
IMAP_PORT=993
IMAP_USER=recepcion@tuhotel.com
IMAP_PASSWORD=tu_password_aqui

# 3. CREDENCIALES API GOOGLE SHEETS (Cuenta de Servicio)
# Debes crear un Proyecto en Google Cloud, habilitar Google Sheets API,
# y crear unas credenciales de "Cuenta de Servicio".
GOOGLE_SERVICE_ACCOUNT_EMAIL=tu-cuenta-de-servicio@tu-proyecto.iam.gserviceaccount.com
# Asegúrate de mantener los saltos de línea (\n) si lo pegas en una sola línea
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nTU_CLAVE_PRIVADA_AQUI\n-----END PRIVATE KEY-----\n"
